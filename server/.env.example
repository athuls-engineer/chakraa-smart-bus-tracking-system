# ==============================================================================
# CHAAKRA FLEET BACKEND - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and populate with your credentials:
# cp .env.example .env

PORT=6000
NODE_ENV=development

# MongoDB Connection String (Prisma ORM)
DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/chakraa?retryWrites=true&w=majority"

# Twilio SMS Verification Service
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_twilio_auth_token"
TWILIO_SERVICE_SID="VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Nylas Email API
NYLAS_API_KEY="your_nylas_api_key"
USER_GRANT_ID="your_nylas_grant_id"

# Razorpay Payment Gateway
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxxxxxxx"
RAZORPAY_KEY_SECRET="your_razorpay_secret"

# JWT Auth Secrets
ACCESS_TOKEN_SECRET="your_jwt_access_token_secret"
REFRESH_TOKEN_SECRET="your_jwt_refresh_token_secret"
EMAIL_ACTIVATION_SECRET="your_jwt_email_activation_secret"
